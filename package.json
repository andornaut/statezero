{
  "name": "statezero",
  "version": "0.9.2",
  "author": "andornaut",
  "description": "Small, simple, functional JavaScript library for managing immutable state",
  "keywords": [
    "flux",
    "functional",
    "immutable",
    "minimal",
    "observable",
    "observer",
    "pubsub",
    "reactive",
    "redux-alternative",
    "state",
    "state-management",
    "store"
  ],
  "license": "MIT",
  "main": "dist/statezero.js",
  "module": "dist/statezero.esm.js",
  "browser": "./dist/statezero.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/statezero.esm.js",
      "require": "./dist/statezero.js"
    },
    "./src": {
      "import": "./src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andornaut/statezero.git"
  },
  "homepage": "https://github.com/andornaut/statezero#readme",
  "bugs": "https://github.com/andornaut/statezero/issues",
  "dependencies": {
    "deep-diff": "^1.0.2",
    "lodash-es": "^4.18.1",
    "simple-deep-freeze": "^0.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "size-limit": "^14.0.0"
  },
  "scripts": {
    "internal:build": "npm run internal:build:esm && npm run internal:build:umd",
    "build": "make build",
    "internal:build:esm": "esbuild src/index.js --bundle --format=esm --packages=external --outfile=dist/statezero.esm.js",
    "build:esm": "make exec COMMAND='npm run internal:build:esm'",
    "internal:build:production": "npm run internal:build:esm -- --minify && npm run internal:build:umd -- --minify",
    "build:production": "make exec COMMAND='npm run internal:build:production'",
    "internal:build:umd": "esbuild src/index.js --bundle --format=iife --global-name=statezero --outfile=dist/statezero.js",
    "build:umd": "make exec COMMAND='npm run internal:build:umd'",
    "internal:format": "prettier --write . && eslint --fix .",
    "format": "make exec COMMAND='npm run internal:format'",
    "internal:lint": "prettier --check . && eslint --max-warnings 0 .",
    "lint": "make lint",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run build:production",
    "internal:size": "size-limit",
    "size": "make build",
    "internal:test": "jest",
    "test": "make test",
    "internal:test:watch": "jest --watch",
    "test:watch": "make exec COMMAND='npm run internal:test:watch'",
    "check": "make check"
  },
  "//": "WORKAROUND: https://github.com/advisories/GHSA-g3hv-75wg-m249. Remove when upstream dependency ranges require patched minimatch versions.",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
